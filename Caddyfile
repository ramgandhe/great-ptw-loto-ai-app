# HTTP reverse proxy (IP or hostname). TLS/site names are added when a domain exists.
#
# Usage: docker compose -f docker-compose.yml -f docker-compose.demo.yml -f docker-compose.caddy.yml up -d
#
# Site addresses come from CADDY_SITES (default :80, plain http on any host).
# With a domain, e.g. CADDY_SITES="permitwiseai.cloud, :80", Caddy gets a certificate for it,
# redirects its http to https, and still serves the bare IP over http.

{$CADDY_SITES::80} {
	encode gzip

	handle /api/* {
		reverse_proxy api:4000
	}




	# Presigned evidence links (bucket path). Caddy keeps the Host header, so signatures match.
	handle /ptw-documents/* {
		reverse_proxy minio:9000
	}


	handle {
		reverse_proxy frontend:3000
	}
}
