# ---------------------------------------------------------------------------
# Environment configuration for the PTW platform API.
# Copy to `.env` and adjust for your environment. `.env` is gitignored.
# Values below are LOCAL DEVELOPMENT defaults — never commit real secrets.
# All variables in the "Required" section are validated at API startup
# (see app/src/config/validate-env.ts); a missing one aborts a production boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Required: PostgreSQL ---
DATABASE_URL=postgresql://ptw:ptw_dev_password@localhost:5432/ptw_platform

# --- Required: Redis (cache + BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Required: MinIO (object storage / isolation evidence) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ptw_minio
MINIO_SECRET_KEY=ptw_minio_password
MINIO_BUCKET=ptw-documents

# --- Required: Keycloak (authentication / role validation) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ptw-platform
KEYCLOAK_CLIENT_ID=ptw-api

# --- Required: Grafana Loki (structured logging) ---
LOKI_URL=http://localhost:3100

# --- Isolation Execution (SP-03.02) ---
ISOLATION_CACHE_TTL_SECONDS=300
# Reminder sweep for active isolation sessions (BullMQ repeatable job).
ISOLATION_REMINDER_CRON=0 */4 * * *
# Expiry for presigned MinIO evidence upload/download URLs.
ISOLATION_EVIDENCE_URL_EXPIRY_SECONDS=3600

# --- Restoration & History (SP-03.03) ---
RESTORATION_CACHE_TTL_SECONDS=300
# Notification sweep for verified executions pending restoration (BullMQ job).
RESTORATION_NOTIFICATION_CRON=0 */6 * * *
# Expiry for presigned MinIO restoration-evidence upload/download URLs.
RESTORATION_EVIDENCE_URL_EXPIRY_SECONDS=3600

# --- Multi-Day Permit / Daily Progress (SP-05.01) ---
MDP_CACHE_TTL_SECONDS=300
# Reminder sweep for active multi-day permits (BullMQ repeatable job).
MDP_DAILY_REMINDER_CRON=0 7 * * *
# Expiry for presigned MinIO daily-progress evidence URLs.
MDP_EVIDENCE_URL_EXPIRY_SECONDS=3600
# Object key prefix inside MINIO_BUCKET for daily evidence.
MDP_EVIDENCE_PREFIX=mdp/daily-progress

# --- Multi-Day Permit / Daily Revalidation (SP-05.02) ---
MDP_REVALIDATION_CACHE_TTL_SECONDS=300
MDP_REVALIDATION_REMINDER_CRON=0 6 * * *
MDP_EXTENSION_EXPIRY_CRON=0 5 * * *

# --- Incident Recording (SP-06.01) ---
INCIDENT_CACHE_TTL_SECONDS=300
# Reminder sweep for open incidents awaiting Safety Officer attention.
INCIDENT_OPEN_REMINDER_CRON=0 8 * * *
# Expiry for presigned MinIO incident-evidence URLs.
INCIDENT_EVIDENCE_URL_EXPIRY_SECONDS=3600
# Object key prefix inside MINIO_BUCKET for incident evidence.
INCIDENT_EVIDENCE_PREFIX=incidents/evidence
