# ---------------------------------------------------------------------------
# Environment configuration for the PTW platform API.
# Copy to `.env` and adjust for your environment. `.env` is gitignored.
# Values below are LOCAL DEVELOPMENT defaults — never commit real secrets.
# For production go-live, copy `.env.production.example` → `.env.production`
# and deploy with `docker compose -f docker-compose.yml -f docker-compose.prod.yml`.
# All variables in the "Required" section are validated at API startup
# (see app/src/config/validate-env.ts); a missing one aborts a production boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Required: PostgreSQL ---
DATABASE_URL=postgresql://ptw:ptw_dev_password@localhost:5432/ptw_platform
# Connection pool tuning (SP-08.02).
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Required: Redis (cache + BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional Redis AUTH password (leave empty for local compose without --requirepass).
REDIS_PASSWORD=
# BullMQ worker concurrency (SP-08.02).
BULLMQ_WORKER_CONCURRENCY=5

# API throttling (Nest Throttler).
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Security hardening toggles (SP-08.02).
SECURITY_HELMET_ENABLED=true
SECURITY_TRUST_PROXY=false
# Max JSON/urlencoded body size for Nest API.
API_BODY_LIMIT=1mb

# --- Required: MinIO (object storage / isolation evidence) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=ptw_minio
MINIO_SECRET_KEY=ptw_minio_password
MINIO_BUCKET=ptw-documents

# --- Required: Keycloak (authentication / role validation) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ptw-platform
KEYCLOAK_CLIENT_ID=ptw-api

# --- Required: Grafana Loki (structured logging) ---
LOKI_URL=http://localhost:3100

# --- Isolation Execution (SP-03.02) ---
ISOLATION_CACHE_TTL_SECONDS=300
# Reminder sweep for active isolation sessions (BullMQ repeatable job).
ISOLATION_REMINDER_CRON=0 */4 * * *
# Expiry for presigned MinIO evidence upload/download URLs.
ISOLATION_EVIDENCE_URL_EXPIRY_SECONDS=3600

# --- Restoration & History (SP-03.03) ---
RESTORATION_CACHE_TTL_SECONDS=300
# Notification sweep for verified executions pending restoration (BullMQ job).
RESTORATION_NOTIFICATION_CRON=0 */6 * * *
# Expiry for presigned MinIO restoration-evidence upload/download URLs.
RESTORATION_EVIDENCE_URL_EXPIRY_SECONDS=3600

# --- Multi-Day Permit / Daily Progress (SP-05.01) ---
MDP_CACHE_TTL_SECONDS=300
# Reminder sweep for active multi-day permits (BullMQ repeatable job).
MDP_DAILY_REMINDER_CRON=0 7 * * *
# Expiry for presigned MinIO daily-progress evidence URLs.
MDP_EVIDENCE_URL_EXPIRY_SECONDS=3600
# Object key prefix inside MINIO_BUCKET for daily evidence.
MDP_EVIDENCE_PREFIX=mdp/daily-progress

# --- Multi-Day Permit / Daily Revalidation (SP-05.02) ---
MDP_REVALIDATION_CACHE_TTL_SECONDS=300
MDP_REVALIDATION_REMINDER_CRON=0 6 * * *
MDP_EXTENSION_EXPIRY_CRON=0 5 * * *

# --- Incident Recording (SP-06.01) ---
INCIDENT_CACHE_TTL_SECONDS=300
# Reminder sweep for open incidents awaiting Safety Officer attention.
INCIDENT_OPEN_REMINDER_CRON=0 8 * * *
# Expiry for presigned MinIO incident-evidence URLs.
INCIDENT_EVIDENCE_URL_EXPIRY_SECONDS=3600
# Object key prefix inside MINIO_BUCKET for incident evidence.
INCIDENT_EVIDENCE_PREFIX=incidents/evidence

# --- Investigation (SP-06.02) ---
INVESTIGATION_CACHE_TTL_SECONDS=300
# Reminder sweep for overdue corrective actions.
INVESTIGATION_OVERDUE_ACTION_CRON=0 9 * * *

# --- Incident Closure (SP-06.03) ---
INCIDENT_CLOSURE_CACHE_TTL_SECONDS=300
# Reminder sweep for verified incidents pending closure.
INCIDENT_CLOSURE_NOTIFY_CRON=0 10 * * *

# --- Notifications (SP-07.01) ---
NOTIFICATION_CACHE_TTL_SECONDS=300
# Sweep failed deliveries whose next_retry_at is due (BR-NTF-005).
NOTIFICATION_DELIVERY_RETRY_CRON=*/5 * * * *
# Daily task-reminder sweep (FR-NTF-002).
NOTIFICATION_TASK_REMINDER_CRON=0 7 * * *
NOTIFICATION_PERMIT_EXPIRY_CRON=0 6 * * *
NOTIFICATION_PERMIT_EXPIRY_HORIZON_HOURS=48
NOTIFICATION_MAX_DELIVERY_RETRIES=5

# --- Dashboards & Analytics (SP-07.02) ---
DASHBOARD_CACHE_TTL_SECONDS=120
# Sweep pending report_exports for generation (FR-DSH-005).
DASHBOARD_REPORT_GENERATE_CRON=*/10 * * * *
# Nightly analytics_snapshots capture (FR-DSH-004).
DASHBOARD_ANALYTICS_SNAPSHOT_CRON=0 1 * * *
# Refresh expired kpi_cache rows (FR-DSH-006).
DASHBOARD_KPI_REFRESH_CRON=*/15 * * * *
# Object key prefix inside MINIO_BUCKET for generated reports.
DASHBOARD_REPORT_PREFIX=dashboards/reports
# Optional Metabase base URL for embedded analytics (leave empty if unused).
METABASE_URL=

# --- Billing & Subscription (SP-08.01) ---
BILLING_CACHE_TTL_SECONDS=300
# Nightly billing cycle / invoice draft sweep (FR-BIL-004).
BILLING_CYCLE_INVOICE_CRON=0 2 * * *
# Hourly usage aggregation into usage_records (FR-BIL-003).
BILLING_USAGE_AGGREGATE_CRON=0 * * * *
# Daily renewal notification sweep (FR-BIL-005).
BILLING_RENEWAL_NOTIFY_CRON=0 9 * * *
# Days ahead to flag upcoming renewals.
BILLING_RENEWAL_HORIZON_DAYS=7
