{
  "name": "great-ptw-loto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app",
    "frontend",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build -w @ptw/shared && npm run test --workspaces --if-present",
    "dev:api": "API_PORT=4000 npm run start:dev -w api",
    "dev:web": "PORT=3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1 npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "db:migrate": "npm run db:migrate -w api",
    "db:reset": "npm run db:reset -w api",
    "db:seed": "npm run db:seed -w api",
    "healthcheck": "tsx scripts/healthcheck.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
