# Production environment template (SP-08.03).
# Copy to `.env.production` and replace every placeholder with real secrets.
# Never commit `.env.production`.

NODE_ENV=production
API_PORT=4000
API_VERSION=v1
LOG_LEVEL=info

# Public URLs (used by Caddy, CORS, Keycloak hostname and Next.js build args)
APP_DOMAIN=ptw.example.com
API_DOMAIN=api.ptw.example.com
AUTH_DOMAIN=auth.ptw.example.com
CADDY_EMAIL=ops@example.com
CORS_ORIGIN=https://ptw.example.com
NEXT_PUBLIC_APP_URL=https://ptw.example.com
NEXT_PUBLIC_API_URL=https://api.ptw.example.com/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.ptw.example.com
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ptw-web

# PostgreSQL
POSTGRES_USER=ptw
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=ptw_platform
DATABASE_URL=postgresql://ptw:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ptw_platform
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis / BullMQ
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BULLMQ_WORKER_CONCURRENCY=5

# API hardening
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
SECURITY_HELMET_ENABLED=true
SECURITY_TRUST_PROXY=true
API_BODY_LIMIT=1mb

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=ptw-documents

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER=https://auth.ptw.example.com
KEYCLOAK_REALM=ptw-platform
KEYCLOAK_CLIENT_ID=ptw-api
KEYCLOAK_ADMIN=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_HOSTNAME=auth.ptw.example.com

# Loki
LOKI_URL=http://loki:3100

# Optional Metabase
METABASE_URL=
