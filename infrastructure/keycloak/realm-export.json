{
  "realm": "ptw-platform",
  "enabled": true,
  "displayName": "PTW Platform",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Platform administrator"
      },
      {
        "name": "org-admin",
        "description": "Organisation administrator"
      },
      {
        "name": "supervisor",
        "description": "Operational supervisor"
      },
      {
        "name": "operator",
        "description": "Field operator"
      },
      {
        "name": "job-issuer",
        "description": "Job Issuer \u2014 creates and submits permits"
      },
      {
        "name": "viewer",
        "description": "Read-only viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ptw-web",
      "name": "PTW Web Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "ptw-api",
      "name": "PTW API Service",
      "enabled": true,
      "publicClient": false,
      "secret": "ptw-api-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ptw-mobile",
      "name": "PTW Mobile Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "ptw://callback/*",
        "exp://localhost:8081/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "email": "admin@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin"
      ]
    },
    {
      "username": "orgadmin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Org",
      "lastName": "Admin",
      "email": "orgadmin@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "orgadmin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-admin"
      ]
    },
    {
      "username": "issuer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Job",
      "lastName": "Issuer",
      "email": "issuer@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "job-issuer"
      ]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Safety",
      "lastName": "Supervisor",
      "email": "supervisor@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supervisor",
        "org-admin"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "tenant"
  ]
}
