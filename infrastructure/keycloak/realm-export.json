      {
        "name": "org-admin",
        "description": "Organisation administrator (System Administrator)"
      },
      {
        "name": "hod",
        "description": "Head of Department — approves, closes, and authorises permits"
      },
      {
        "name": "operator",
        "description": "Job Executor — field operator"
      },
      {
        "name": "job-issuer",
        "description": "Job Issuer — creates and submits permits"
      },
      {
        "name": "viewer",
        "description": "Read-only viewer"
      },
      {
        "name": "safety-officer",
        "description": "Safety Officer — safety gate and verification"
      }
    ]
  },
  "clients": [
