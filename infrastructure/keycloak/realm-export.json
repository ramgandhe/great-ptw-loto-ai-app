{
  "realm": "ptw-platform",
  "enabled": true,
  "displayName": "PTW Platform",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Platform administrator"
      },
      {
        "name": "org-admin",
        "description": "Organisation administrator"
      },
      {
        "name": "supervisor",
        "description": "Operational supervisor"
      },
      {
        "name": "operator",
        "description": "Field operator"
      },
      {
        "name": "job-issuer",
        "description": "Job Issuer \u2014 creates and submits permits"
      },
      {
        "name": "viewer",
        "description": "Read-only viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ptw-web",
      "name": "PTW Web Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "tenant",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "ptw-api",
      "name": "PTW API Service",
      "enabled": true,
      "publicClient": false,
      "secret": "ptw-api-dev-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "tenant",
        "roles"
      ]
    },
    {
      "clientId": "ptw-mobile",
      "name": "PTW Mobile Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "ptw://callback/*",
        "exp://localhost:8081/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "tenant",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "email": "admin@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin"
      ]
    },
    {
      "username": "orgadmin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Org",
      "lastName": "Admin",
      "email": "orgadmin@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "orgadmin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "org-admin"
      ]
    },
    {
      "username": "issuer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Job",
      "lastName": "Issuer",
      "email": "issuer@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "job-issuer"
      ]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Safety",
      "lastName": "Supervisor",
      "email": "supervisor@ptw.local",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "supervisor",
        "org-admin"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for basic claims (sub)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles for API RBAC",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "openid",
    "profile",
    "email",
    "tenant",
    "roles"
  ]
}
